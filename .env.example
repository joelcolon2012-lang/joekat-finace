# ===================================================
# JOEKAT FINACE - Variables de Entorno de Supabase
# ===================================================
# Obtén estas credenciales en https://supabase.com -> Tu Proyecto -> Settings -> API
# La URL de tu proyecto Supabase:
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# La clave pública (anon key) con permisos Row Level Security activos:
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key-aqui
